# Copy this file to `.env` and fill in the real values from your Supabase project.
# Supabase dashboard -> Settings -> API
#
# The `.env` file must be gitignored. The ANON key is safe to ship in the app
# (RLS protects the data); the service_role key must NEVER go here.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
